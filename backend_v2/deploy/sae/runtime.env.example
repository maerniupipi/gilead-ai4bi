# 推荐运行 python deploy/setup_env.py 自动生成独立密钥与管理员初始密码。
# 此文件仅为配置说明；复制后请替换所有 REPLACE_* 值。
XIAOYING_ENVIRONMENT=production
XIAOYING_CHATBOT_MODE=dual
XIAOYING_DATABASE_URL=sqlite:///./var/control.sqlite3
# MySQL 8 示例；密码中的特殊字符须按 URL 编码：
# XIAOYING_DATABASE_URL=mysql+pymysql://gilead_react_app:REPLACE_PASSWORD@127.0.0.1:3306/gilead_agent_loop?charset=utf8mb4
XIAOYING_DB_AUTO_CREATE=false
XIAOYING_AUTH_HMAC_SECRET=REPLACE_WITH_RANDOM_AUTH_SECRET_AT_LEAST_32_BYTES
XIAOYING_SQL_APPROVAL_HMAC_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SQL_SECRET_AT_LEAST_32_BYTES
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
XIAOYING_MASTER_KEY=REPLACE_WITH_FERNET_KEY
XIAOYING_PROVISION_TOKEN=REPLACE_WITH_RANDOM_PROVISION_TOKEN
XIAOYING_AUTH_TOKEN_TTL_SECONDS=28800
XIAOYING_BOOTSTRAP_ADMIN_USERNAME=admin
XIAOYING_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD
XIAOYING_SECRET_STORE_PATH=var/secrets.json
XIAOYING_SECRET_KEY_PATH=var/master.key
XIAOYING_BRANDING_ASSETS_PATH=var/branding
XIAOYING_KNOWLEDGE_ROOT=../knowledge_gilead
XIAOYING_STATIC_ROOT=
XIAOYING_JOB_MAX_WORKERS=2
XIAOYING_DATABASE_POOL_SIZE=5
XIAOYING_DATABASE_MAX_OVERFLOW=5
XIAOYING_LAB_FALLBACK=off
XIAOYING_LAB_FALLBACK_ON_ERROR=false
XIAOYING_ALLOW_SQLITE_DATA_SOURCES=false
XIAOYING_DATA_SOURCE_ALLOWED_HOSTS=127.0.0.1,localhost
XIAOYING_CORS_ALLOWED_ORIGINS=http://127.0.0.1:15173,http://localhost:15173
# 可在网页「模型管理」中填写并启用；设置环境变量会在空模型库中初始化模型。
XIAOYING_MODEL_ENDPOINT_URL=
XIAOYING_MODEL_API_KEY=
XIAOYING_MODEL_ID=
XIAOYING_MODEL_MAX_TOKENS=16384
XIAOYING_MODEL_TIMEOUT_SECONDS=180
# 数据库问数可通过管理界面配置 Bootcamp / 百炼实验室，再绑定业务数据库。
XIAOYING_LAB_DEFAULT_PROVIDER=bootcamp
XIAOYING_LAB_BOOTCAMP_ENDPOINT_URL=
XIAOYING_LAB_ENDPOINT_URL=
XIAOYING_LAB_ACTUAL_TOKEN=
